{
  "name": "ecommerce-playwright-framework",
  "version": "1.0.0",
  "description": "End-to-end UI automation framework for an e-commerce site using Playwright and the Page Object Model",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "pretest:allure": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test:allure": "allure run -- npx playwright test",
    "allure:generate": "allure generate ./allure-results",
    "allure:open": "allure open"
  },
  "keywords": [
    "playwright",
    "e2e",
    "test-automation",
    "page-object-model"
  ],
  "author": "Pubudu Gunawardhana",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10"
  }
}
